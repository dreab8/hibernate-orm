<entity-mappings xmlns="http://www.hibernate.org/xsd/orm/mapping"
                 version="8.0">

    <entity class="org.hibernate.orm.test.hql.Image"
            access="FIELD" metadata-complete="true">
        <table name="image"/>
        <attributes>
            <id name="id">
                <generated-value/>
            </id>
            <basic name="name"/>
            <basic name="sizeKb" fetch="LAZY">
                <column name="size_mb">
                    <read>size_mb * 1024.0</read>
                    <write>? / 1024.0 </write>
                </column>
            </basic>
        </attributes>
    </entity>

</entity-mappings>
